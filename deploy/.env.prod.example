# 服务器 /opt/commerce-core/.env 的键清单。
# 不要提交真实值；这个文件只是给用户照着填的模板。
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=120.24.67.82,localhost,127.0.0.1

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=commerce
MYSQL_USER=commerce
MYSQL_PASSWORD=

REDIS_URL=redis://redis:6379/0

ACR_REGISTRY=crpi-3tubdvd6wrolewii.cn-shenzhen.personal.cr.aliyuncs.com
# 部署脚本改写这一行；回滚就是把上一版 sha 写回来
IMAGE_TAG=s2

# 公网演示要能点「模拟支付」，否则 /pay 一律 403。这是可点的 mock 支付，不是真实支付通道。
ENABLE_MOCK_PAY=true
# 回调签名密钥，独立于 SECRET_KEY；留空则回落到 SECRET_KEY
PAY_CALLBACK_SECRET=
